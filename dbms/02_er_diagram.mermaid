erDiagram
    %% Entity Definitions with Attributes
    
    USERS {
        int user_id PK
        varchar username
        varchar email UK
        varchar password
        varchar phone_number
        text street_address
        int city_id FK
        varchar pincode
        datetime registration_date
    }
    
    STATES {
        int state_id PK
        varchar state_name
        varchar country
    }
    
    CITIES {
        int city_id PK
        varchar city_name
        int state_id FK
    }
    
    BRANDS {
        int brand_id PK
        varchar brand_name UK
        varchar brand_logo
        text description
        varchar country_of_origin
    }
    
    PHONE_MODELS {
        int model_id PK
        int brand_id FK
        varchar model_name
        int release_year
        decimal display_size
        varchar processor
        varchar os_version
        int battery_capacity
    }
    
    CAMERA_SPECS {
        int camera_id PK
        int model_id FK
        varchar camera_type
        int megapixels
        decimal aperture
    }
    
    PHONE_LISTINGS {
        int listing_id PK
        int model_id FK
        int seller_id FK
        int storage_capacity
        int ram
        varchar color
        varchar condition
        datetime listing_date
        varchar status
        boolean is_verified
        datetime verification_date
        varchar listing_type
    }
    
    PRICING {
        int price_id PK
        int listing_id FK
        decimal base_price
        decimal discount_amount
        decimal final_price
        datetime price_updated_date
    }
    
    TRANSACTIONS {
        int transaction_id PK
        int listing_id FK
        int buyer_id FK
        datetime transaction_date
        decimal amount
        varchar payment_method
        varchar payment_status
        varchar order_status
    }
    
    SHIPPING_DETAILS {
        int shipping_id PK
        int transaction_id FK
        text street_address
        int city_id FK
        varchar pincode
        varchar shipping_status
        varchar tracking_number
        datetime shipped_date
        datetime delivered_date
    }
    
    REVIEWS {
        int review_id PK
        int reviewer_id FK
        int listing_id FK
        int rating
        text review_text
        datetime review_date
    }
    
    WISHLIST {
        int wishlist_id PK
        int user_id FK
        int listing_id FK
        datetime added_date
    }
    
    %% Relationships
    
    %% Location Relationships
    STATES ||--o{ CITIES : "contains"
    CITIES ||--o{ USERS : "has_residents"
    CITIES ||--o{ SHIPPING_DETAILS : "ships_to"
    
    %% Brand and Model Relationships
    BRANDS ||--o{ PHONE_MODELS : "manufactures"
    PHONE_MODELS ||--o{ CAMERA_SPECS : "has_camera"
    PHONE_MODELS ||--o{ PHONE_LISTINGS : "model_of"
    
    %% Listing Relationships
    USERS ||--o{ PHONE_LISTINGS : "sells"
    PHONE_LISTINGS ||--o{ PRICING : "priced_at"
    PHONE_LISTINGS ||--o{ TRANSACTIONS : "sold_via"
    PHONE_LISTINGS ||--o{ REVIEWS : "reviewed_in"
    PHONE_LISTINGS ||--o{ WISHLIST : "wished_in"
    
    %% Transaction Relationships
    USERS ||--o{ TRANSACTIONS : "purchases"
    TRANSACTIONS ||--|| SHIPPING_DETAILS : "has_shipping"
    
    %% Review and Wishlist Relationships
    USERS ||--o{ REVIEWS : "writes"
    USERS ||--o{ WISHLIST : "creates"
